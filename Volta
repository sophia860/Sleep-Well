<script>
const S={name:'After the Flood',view:'canvas',poems:[],sel:null,ti:0,ar:'dark',gr:'ambivalent'};
const REGS=[{id:'dark',lab:'Elegiac',col:'#3d2e6e',lt:'#e1ddf0'},{id:'grief',lab:'Grief',col:'#b0394a',lt:'#fde8eb'},{id:'ambivalent',lab:'Ambivalent',col:'#7a6a58',lt:'#f0ece6'},{id:'questioning',lab:'Questioning',col:'#3a5a7a',lt:'#ddeaf5'},{id:'light',lab:'Light',col:'#3a6b4a',lt:'#dff0e7'},{id:'declarative',lab:'Declarative',col:'#c47a1a',lt:'#fdf0d8'}];
const SEEDS=[
  {id:'p1',title:'Shoreline Aubade',line:'The sea withdraws its tongue from the cold stones',reg:'light',tags:['water','morning','departure'],body:'The sea withdraws its tongue from the cold stones,\nleaves a film of light on everything it touched.\nI dressed before you woke.\nThe gulls had already made their announcements.',x:60,y:60,ann:'',ghost:false},
  {id:'p2',title:'What the Inheritance Was',line:'Not money. Not land. The silence in the hallway',reg:'ambivalent',tags:['family','silence','grief'],body:'Not money. Not land. The silence in the hallway\nbetween your door and mine.\nThe specific weight of not speaking\nhanded down like silverware, still warm.',x:285,y:78,ann:'',ghost:false},
  {id:'p3',title:'Apocrypha',line:'There are gospels no one wrote down',reg:'questioning',tags:['faith','doubt','memory'],body:'There are gospels no one wrote down:\nthe argument in the kitchen,\nhow you cried when the dog died, not the people.\nI am collecting them.',x:510,y:60,ann:'',ghost:false},
  {id:'p4',title:'After the Flood (I)',line:'We stood in the house in the water',reg:'grief',tags:['water','loss','home'],body:'We stood in the house in the water.\nThe floorboards softened underfoot.\nYou said: well, this is it then.\nWe held the cat above the waterline.',x:110,y:280,ann:'',ghost:false},
  {id:'p5',title:'Taxidermy',line:'The fox behind glass still runs',reg:'dark',tags:['death','time','preservation'],body:'The fox behind glass still runs.\nSomeone has arranged the fur\nso it seems to be arriving.\nNothing has actually arrived.',x:340,y:295,ann:'',ghost:false},
  {id:'p6',title:'On Buying Back the House',line:'We signed the papers in a room that smelled of other people',reg:'declarative',tags:['home','return','hope'],body:'We signed the papers in a room that smelled of other people.\nThe solicitor had clean hands.\nI thought: we are allowed to want things.\nI thought: here.',x:565,y:278,ann:'',ghost:false},
  {id:'p7',title:'Vigil',line:'Hospitals have a particular quality of night',reg:'grief',tags:['mortality','family','waiting'],body:'Hospitals have a particular quality of night.\nThe clock does not behave.\nI was reading the same page for an hour\nbefore I noticed the light had changed.',x:185,y:500,ann:'',ghost:false},
  {id:'p8',title:'The Swimmers',line:'Every morning they go in without fuss',reg:'light',tags:['ritual','water','body'],body:'Every morning they go in without fuss.\nThe cold receives them\nas if they had always been expected.\nI watch from the wall. Not yet.',x:440,y:512,ann:'',ghost:false}
];
const esc=s=>s?String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'):'';
const rg=id=>REGS.find(r=>r.id===id)||REGS[0];
function init(){S.poems=SEEDS.map(p=>({...p}));document.getElementById('coll-disp').textContent=S.name;render();buildP();updArc();updIns();updSpine();}
let _theme='light';
function toggleTheme(){_theme=_theme==='light'?'dark':'light';document.documentElement.setAttribute('data-theme',_theme);const b=document.getElementById('theme-btn');b.innerHTML=_theme==='dark'?'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';}
function buildP(){['mreg-add','mreg-ghost'].forEach(cid=>{const cur=cid==='mreg-add'?S.ar:S.gr;document.getElementById(cid).innerHTML=REGS.map(r=>`<button class="mreg-b${r.id===cur?' sel':''}" style="background:${r.lt};color:${r.col}" onclick="pickR('${cid}','${r.id}')">${r.lab}</button>`).join('');});}
function pickR(cid,id){if(cid==='mreg-add')S.ar=id;else S.gr=id;document.querySelectorAll('#'+cid+' .mreg-b').forEach(b=>b.classList.toggle('sel',b.getAttribute('onclick').includes("'"+id+"'")));}
function render(){renderSB();renderCV();}
function renderSB(){const l=document.getElementById('sb-list');document.getElementById('pc').textContent=S.poems.length;if(!S.poems.length){l.innerHTML='<div style="padding:var(--sp6) var(--sp4);font-size:var(--text-xs);color:var(--txf)">No poems yet.</div>';return;}l.innerHTML=S.poems.map((p,i)=>`<div class="sb-poem${S.sel===p.id?' sel':''} fu" onclick="doSel('${p.id}')" role="button" tabindex="0" onkeydown="if(event.key==='Enter')doSel('${p.id}')"><div class="reg-dot" style="background:${rg(p.reg).col}"></div><div class="sb-body"><div class="sb-title">${p.ghost?'[ghost] ':''}${esc(p.title)}</div><div class="sb-line">${esc(p.line||'')}</div></div><span class="sb-num">${String(i+1).padStart(2,'0')}</span></div>`).join('');}
function renderCV(){const ci=document.getElementById('cvs-inner');ci.innerHTML=S.poems.map((p,i)=>`<div class="pnode${S.sel===p.id?' sel':''}" id="n-${p.id}" style="left:${p.x}px;top:${p.y}px${p.ghost?';border:2px dashed var(--brd);background:var(--soff);opacity:.75':''}" onclick="doSel('${p.id}')" onmousedown="doDrag(event,'${p.id}')"><div class="pnode-top"><span class="rbadge" style="background:${rg(p.reg).lt};color:${rg(p.reg).col}">${rg(p.reg).lab}</span><span class="pnode-num">${String(i+1).padStart(2,'0')}</span></div><div class="pnode-title">${p.ghost?'[Ghost]<br>':''}${esc(p.title)}</div>${p.line&&!p.ghost?`<div class="pnode-line">${esc(p.line)}</div>`:''}<div class="pnode-tags">${(p.tags||[]).slice(0,3).map(t=>`<span class="pnode-tag">${esc(t)}</span>`).join('')}</div></div>`).join('');}
function doDrag(e,id){if(e.button!==0)return;const nd=document.getElementById('n-'+id);const pm=S.poems.find(p=>p.id===id);if(!pm)return;const sf=document.getElementById('cvs');const sr=sf.getBoundingClientRect();const nr=nd.getBoundingClientRect();const ox=e.clientX-nr.left,oy=e.clientY-nr.top;nd.classList.add('dragging');let moved=false;function mv(ev){moved=true;pm.x=Math.max(0,ev.clientX-sr.left+sf.scrollLeft-ox);pm.y=Math.max(0,ev.clientY-sr.top+sf.scrollTop-oy);nd.style.left=pm.x+'px';nd.style.top=pm.y+'px';}function up(){nd.classList.remove('dragging');document.removeEventListener('mousemove',mv);document.removeEventListener('mouseup',up);if(moved){S.sel=id;renderSB();}}document.addEventListener('mousemove',mv);document.addEventListener('mouseup',up);e.preventDefault();}
function doSel(id){S.sel=id;render();}
function sw(v){S.view=v;['canvas','arc','inspector','spine'].forEach(n=>{document.getElementById(n+'-panel').classList.toggle('active',n===v);const t=document.getElementById('t-'+n);if(t){t.classList.toggle('active',n===v);t.setAttribute('aria-selected',n===v);}});if(v==='arc')updArc();if(v==='inspector')updIns();if(v==='spine')updSpine();}
function updArc(){const ps=S.poems;const bl=document.getElementById('arc-blocks');const fl=document.getElementById('arc-flags');const lg=document.getElementById('arc-leg');if(!ps.length){bl.innerHTML='<div style="font-size:var(--text-xs);color:var(--txf);padding:var(--sp4)">No poems yet.</div>';fl.innerHTML='';lg.innerHTML='';return;}bl.innerHTML=ps.map((p,i)=>`<div class="arc-block" style="background:${rg(p.reg).lt};border:1.5px solid ${rg(p.reg).col}40" onclick="doSel('${p.id}');sw('canvas')"><div class="arc-tt">${String(i+1).padStart(2,'0')} — ${esc(p.title)}<br>${rg(p.reg).lab}</div></div>`).join('');const us=[...new Set(ps.map(p=>p.reg))];lg.innerHTML=us.map(r=>`<div class="leg-item"><div class="leg-dot" style="background:${rg(r).col}"></div>${rg(r).lab}</div>`).join('');let fh='',mr=1,cr=1;for(let i=1;i<ps.length;i++){if(ps[i].reg===ps[i-1].reg)cr++;else cr=1;mr=Math.max(mr,cr);}if(mr>=4)fh+=`<div class="arc-flag warn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--amber)"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg><div><div class="af-t">Tonal flatness detected</div><div class="af-d">${mr} consecutive poems share the same register. Consider inserting a contrasting piece.</div></div></div>`;const gc=ps.filter(p=>p.ghost).length;if(gc)fh+=`<div class="arc-flag info"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--slate)"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 1 0-16 0"/></svg><div><div class="af-t">${gc} ghost placeholder${gc!==1?'s':''}</div><div class="af-d">${gc} unwritten poem${gc!==1?'s':''} holding structural space in the sequence.</div></div></div>`;const lr=ps[ps.length-1]?.reg;if(lr==='grief'||lr==='dark')fh+=`<div class="arc-flag info"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--slate)"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg><div><div class="af-t">Heavy close</div><div class="af-d">Your final poem is in a dark register — is that the intended ending note?</div></div></div>`;if(!fh)fh=`<div class="arc-flag ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--sage)"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg><div><div class="af-t">Arc looks healthy</div><div class="af-d">Good register variety — no structural issues detected.</div></div></div>`;fl.innerHTML=fh;}
function updIns(){const ps=S.poems.filter(p=>!p.ghost);const inf=document.getElementById('ins-info');const bd=document.getElementById('ins-body');if(ps.length<2){inf.textContent='—';bd.innerHTML='<div class="empty"><p>Add at least two poems to inspect transitions.</p></div>';return;}S.ti=Math.max(0,Math.min(S.ti,ps.length-2));const a=ps[S.ti],b=ps[S.ti+1];inf.textContent=String(S.ti+1).padStart(2,'0')+' → '+String(S.ti+2).padStart(2,'0');const aL=(a.body||a.line||'').split('\n').filter(Boolean);const bL=(b.body||b.line||'').split('\n').filter(Boolean);const l3=aL.slice(-3),f3=bL.slice(0,3);const sh=(a.tags||[]).filter(t=>(b.tags||[]).includes(t));const ts=a.reg!==b.reg;const ec=a.tags?.some(t=>(b.body||b.line||'').toLowerCase().includes(t));const chips=[sh.length?`<span class="chip chip-echo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>Shared motif: ${sh.join(', ')}</span>`:'',ts?`<span class="chip chip-shift"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>Tonal shift: ${rg(a.reg).lab} → ${rg(b.reg).lab}</span>`:`<span class="chip chip-risk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>Same register — risk of flatness</span>`,ec?`<span class="chip chip-img"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>Image echo detected</span>`:''].filter(Boolean).join('');bd.innerHTML=`<div class="tr-pair fu"><div class="tr-card"><div class="tr-lbl">Poem ${String(S.ti+1).padStart(2,'0')} — closing lines</div><div class="tr-title">${esc(a.title)}</div><div class="tr-lines">${l3.map((l,i)=>`<div class="tr-line${i===l3.length-1?' hi':' fd'}">${esc(l)}</div>`).join('')}</div></div><div class="tr-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></div><div class="tr-card"><div class="tr-lbl">Poem ${String(S.ti+2).padStart(2,'0')} — opening lines</div><div class="tr-title">${esc(b.title)}</div><div class="tr-lines">${f3.map((l,i)=>`<div class="tr-line${i===0?' hi':' fd'}">${esc(l)}</div>`).join('')}</div></div></div><div class="tr-notes fu"><div class="tr-notes-t">Observations</div><div class="chips">${chips||'<span style="font-size:var(--text-xs);color:var(--txf)">No automatic observations for this pair.</span>'}</div><textarea class="tr-ann" placeholder="Your notes on this transition…" oninput="svAnn('${a.id}',this.value)">${esc(a.ann||'')}</textarea></div>`;}
function prevT(){S.ti=Math.max(0,S.ti-1);updIns();}function nextT(){const max=S.poems.filter(p=>!p.ghost).length-2;S.ti=Math.min(max,S.ti+1);updIns();}
function svAnn(id,v){const p=S.poems.find(x=>x.id===id);if(p)p.ann=v;}
function updSpine(){const dc=document.getElementById('sdoc');const ps=S.poems;if(!ps.length){dc.innerHTML='<div class="empty"><p>Add poems to generate your manuscript spine.</p></div>';return;}const now=new Date().toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'});dc.innerHTML=`<div class="s-title">${esc(S.name)}</div><div class="s-sub">Manuscript spine &middot; ${ps.length} poem${ps.length!==1?'s':''} &middot; ${now}</div><div class="s-div"></div><div class="s-sec">Sequence</div>${ps.map((p,i)=>`<div class="s-row"><div class="s-n">${String(i+1).padStart(2,'0')}</div><div class="s-m"><div class="s-name">${p.ghost?'[ Ghost ] ':''}${esc(p.title)}</div>${p.line&&!p.ghost?`<div class="s-line">${esc(p.line)}</div>`:''}</div><div class="s-r"><span class="s-pill" style="background:${rg(p.reg).lt};color:${rg(p.reg).col}">${rg(p.reg).lab}</span>${p.tags&&p.tags.length?`<div class="s-nt">${esc(p.tags.join(', '))}</div>`:''}</div></div>`).join('')}<div class="s-div"></div><div style="font-size:var(--text-xs);color:var(--txf)">Generated by Volta</div>`;}
function openAdd(){buildP();S.ar='dark';['np-t','np-l','np-tg'].forEach(id=>document.getElementById(id).value='');document.getElementById('np-b').value='';openM('m-add');}
function openGhost(){buildP();S.gr='ambivalent';document.getElementById('gn').value='';openM('m-ghost');}
function openRename(){document.getElementById('cn').value=S.name;openM('m-rename');}
function openM(id){document.querySelectorAll('.moverlay').forEach(m=>m.classList.remove('open'));const m=document.getElementById(id);m.classList.add('open');const fn=m.querySelector('input,textarea');if(fn)setTimeout(()=>fn.focus(),60);}
function closeM(){document.querySelectorAll('.moverlay').forEach(m=>m.classList.remove('open'));}
document.addEventListener('click',e=>{document.querySelectorAll('.moverlay.open').forEach(m=>{if(e.target===m)closeM();});});
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeM();});
function addPoem(){const t=document.getElementById('np-t').value.trim()||'Untitled';const l=document.getElementById('np-l').value.trim();const rw=document.getElementById('np-tg').value.trim();const b=document.getElementById('np-b').value.trim();const tags=rw?rw.split(',').map(x=>x.trim()).filter(Boolean):[];const id='p'+Date.now();const i=S.poems.length;S.poems.push({id,title:t,line:l,reg:S.ar,tags,body:b,x:60+(i%4)*230,y:60+Math.floor(i/4)*210,ann:'',ghost:false});closeM();render();updArc();updSpine();doSel(id);}
function addGhost(){const n=document.getElementById('gn').value.trim()||'Unwritten poem';const id='g'+Date.now();const i=S.poems.length;S.poems.push({id,title:n.length>44?n.slice(0,44)+'…':n,line:'[ placeholder — not yet written ]',reg:S.gr,tags:[],body:'',x:60+(i%4)*230,y:60+Math.floor(i/4)*210,ann:'',ghost:true});closeM();render();updArc();updSpine();}
function renC(){const v=document.getElementById('cn').value.trim();if(!v)return;S.name=v;document.getElementById('coll-disp').textContent=v;closeM();updSpine();}
function arrange(){S.poems.forEach((p,i)=>{p.x=60+(i%4)*230;p.y=60+Math.floor(i/4)*210;});renderCV();}
function shuffle(){for(let i=S.poems.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[S.poems[i],S.poems[j]]=[S.poems[j],S.poems[i]];}render();updArc();updIns();updSpine();}
function printSpine(){const h=document.getElementById('sdoc').innerHTML;const w=window.open('','_blank');if(!w)return;w.document.write('<!DOCTYPE html><html><head><meta charset="UTF-8"><title>'+esc(S.name)+'</title><link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet"><style>body{font-family:\'DM Sans\',sans-serif;max-width:680px;margin:40px auto;padding:40px;color:#1e1c17;font-size:13px;line-height:1.7}.s-title{font-family:\'Instrument Serif\',serif;font-style:italic;font-size:2rem;letter-spacing:-0.02em;margin-bottom:4px}.s-sub{color:#888;font-size:11px;margin-bottom:24px}.s-div{border:none;border-top:1px solid #e0ddd8;margin:18px 0}.s-sec{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:#bbb;margin-bottom:12px;font-weight:700}.s-row{display:flex;gap:14px;padding:9px 0;border-bottom:1px solid #f3f1ee;align-items:flex-start}.s-n{font-size:10px;color:#ccc;width:20px;flex-shrink:0}.s-m{flex:1}.s-name{font-family:\'Instrument Serif\',serif;font-style:italic;font-size:14px}.s-line{font-size:11px;color:#999;margin-top:1px}.s-r{flex-shrink:0;text-align:right}.s-pill{font-size:10px;padding:2px 7px;border-radius:20px;background:#f0ece6;color:#7a6a58}.s-nt{font-size:10px;color:#ccc;font-style:italic;margin-top:2px}@media print{body{margin:0;padding:24px}}</style></head><body>'+h+'</body></html>');w.document.close();setTimeout(()=>w.print(),500);}
init();
</script>
</body>
</html>
